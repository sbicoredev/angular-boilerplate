{
  "name": "angular-boilerplate",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:angular-boilerplate": "node dist/angular-boilerplate/server/server.mjs",
    "typecheck": "tsc --p tsconfig.app.json --noEmit",
    "format": "prettier '**/*.html' --write",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "dependencies": {
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-server": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@angular/ssr": "^21.2.10",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.12",
    "@biomejs/biome": "2.4.14",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "ultracite": "7.6.4",
    "vitest": "^4.1.5"
  }
}
